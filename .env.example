# Database Connection URL (PostgreSQL)
# Format: postgresql+psycopg://<username>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/tracker_db

# Secret key for application session encryption / security
SECRET_KEY=change-this-to-a-secure-random-secret-key

# Fixed Three Users Configuration (Used for seeding and name customization)
PERSON_1_NAME=Person 1
PERSON_1_USERNAME=person1
PERSON_1_PASSWORD=password123

PERSON_2_NAME=Person 2
PERSON_2_USERNAME=person2
PERSON_2_PASSWORD=password123

PERSON_3_NAME=Person 3
PERSON_3_USERNAME=person3
PERSON_3_PASSWORD=password123
